---
import ProductPage from '../../components/ProductPage.astro';
import { getProducts, slugOf } from '../../lib/products';

export async function getStaticPaths() {
  return (await getProducts('en')).map((product) => ({ params: { slug: slugOf(product) }, props: { product } }));
}
const { product } = Astro.props;
---

<ProductPage lang="en" product={product} />
