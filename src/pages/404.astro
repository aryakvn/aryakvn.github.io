---
import Base from '../layouts/Base.astro';
import { href } from '../i18n';
---

<Base lang="en">
  <section class="lost shell">
    <p class="label">404 · The card is not in this deck</p>
    <h1>Nothing here</h1>
    <p class="lede">Either it moved, or it never existed. Both happen.</p>
    <a class="btn btn--solid" href={href('en')}>Back to the table</a>
  </section>
</Base>

<style>
  .lost {
    min-height: 62vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 1.4rem;
    padding-block: 6rem;
  }
  .lost h1 {
    font-size: clamp(2.5rem, 2rem + 4vw, 4.5rem);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
